<mujoco model="double_pendulum">
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <worldbody>
    <body name="upper" pos="0 0 1.5">
      <joint name="shoulder" type="hinge" axis="0 1 0"/>
      <geom name="upper_rod" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.03" density="1000"/>
      <body name="lower" pos="0 0 -0.5">
        <joint name="elbow" type="hinge" axis="0 1 0"/>
        <geom name="lower_rod" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.03" density="1000"/>
      </body>
    </body>
  </worldbody>
  <sensor>
    <jointpos name="shoulder_pos" joint="shoulder"/>
    <jointpos name="elbow_pos" joint="elbow"/>
  </sensor>
</mujoco>
