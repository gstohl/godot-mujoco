[configuration]
entry_symbol = "godot_mujoco_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.linux.template_release.arm64.so"
macos.debug.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.macos.template_debug.arm64.dylib"
macos.debug.x86_64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.macos.template_debug.x86_64.dylib"
macos.release.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.macos.template_release.arm64.dylib"
macos.release.x86_64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.macos.template_release.x86_64.dylib"
windows.debug.x86_64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.android.template_release.arm64.so"
ios.debug.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.ios.template_debug.arm64.dylib"
ios.release.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.ios.template_release.arm64.dylib"

[dependencies]
linux.debug.x86_64 = { "res://addons/godot_mujoco/bin/libmujoco.so.@MUJOCO_VERSION@" : "" }
linux.release.x86_64 = { "res://addons/godot_mujoco/bin/libmujoco.so.@MUJOCO_VERSION@" : "" }
linux.debug.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.so.@MUJOCO_VERSION@" : "" }
linux.release.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.so.@MUJOCO_VERSION@" : "" }
macos.debug.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.dylib" : "", "res://addons/godot_mujoco/bin/libmujoco.@MUJOCO_VERSION@.dylib" : "" }
macos.debug.x86_64 = { "res://addons/godot_mujoco/bin/libmujoco.dylib" : "", "res://addons/godot_mujoco/bin/libmujoco.@MUJOCO_VERSION@.dylib" : "" }
macos.release.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.dylib" : "", "res://addons/godot_mujoco/bin/libmujoco.@MUJOCO_VERSION@.dylib" : "" }
macos.release.x86_64 = { "res://addons/godot_mujoco/bin/libmujoco.dylib" : "", "res://addons/godot_mujoco/bin/libmujoco.@MUJOCO_VERSION@.dylib" : "" }
windows.debug.x86_64 = { "res://addons/godot_mujoco/bin/mujoco.dll" : "" }
windows.release.x86_64 = { "res://addons/godot_mujoco/bin/mujoco.dll" : "" }
android.debug.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.so" : "", "res://addons/godot_mujoco/bin/libc++_shared.so" : "" }
android.release.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.so" : "", "res://addons/godot_mujoco/bin/libc++_shared.so" : "" }
ios.debug.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.dylib" : "" }
ios.release.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.dylib" : "" }
